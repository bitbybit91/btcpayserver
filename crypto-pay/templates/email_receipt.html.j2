{# email_receipt.html.j2 — Payment confirmation email template
   Variables:
     order       : Order dict
     site_name   : Merchant site name
#}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Payment Receipt</title>
</head>
<body style="margin:0;padding:0;background:#f8f9fa;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif">
  <table width="100%" cellpadding="0" cellspacing="0"
         style="max-width:600px;margin:32px auto;background:#fff;border-radius:8px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,0.08)">
    <!-- Header -->
    <tr>
      <td style="background:#f7931a;padding:24px 32px;text-align:center">
        <h1 style="margin:0;color:#fff;font-size:1.4rem">
          &#8383; Payment Confirmed
        </h1>
        <p style="margin:8px 0 0;color:rgba(255,255,255,0.85);font-size:0.9rem">
          {{ site_name | default('Crypto Pay') | e }}
        </p>
      </td>
    </tr>
    <!-- Body -->
    <tr>
      <td style="padding:32px">
        <p style="margin:0 0 16px;color:#212529;font-size:0.95rem">
          Thank you for your payment. Your transaction has been confirmed.
        </p>

        <table width="100%" cellpadding="8" cellspacing="0"
               style="border:1px solid #dee2e6;border-radius:6px;border-collapse:collapse;font-size:0.9rem">
          <tr style="background:#f8f9fa">
            <td style="padding:10px 16px;color:#6c757d;width:40%">Order ID</td>
            <td style="padding:10px 16px;color:#212529;font-family:monospace;word-break:break-all">
              {{ order.order_id | e }}
            </td>
          </tr>
          {% if order.product_name %}
          <tr>
            <td style="padding:10px 16px;color:#6c757d">Product</td>
            <td style="padding:10px 16px;color:#212529">{{ order.product_name | e }}</td>
          </tr>
          {% endif %}
          <tr style="background:#f8f9fa">
            <td style="padding:10px 16px;color:#6c757d">Amount Charged</td>
            <td style="padding:10px 16px;color:#212529;font-weight:600">
              {{ order.fiat_amount }} {{ (order.fiat_currency or 'USD') | upper | e }}
            </td>
          </tr>
          <tr>
            <td style="padding:10px 16px;color:#6c757d">Crypto Amount</td>
            <td style="padding:10px 16px;color:#212529">
              {{ order.crypto_amount | e }} {{ order.crypto_currency | e }}
            </td>
          </tr>
          {% if order.tx_hash %}
          <tr style="background:#f8f9fa">
            <td style="padding:10px 16px;color:#6c757d">Transaction Hash</td>
            <td style="padding:10px 16px;color:#212529;font-family:monospace;word-break:break-all">
              {{ order.tx_hash | e }}
            </td>
          </tr>
          {% endif %}
          <tr>
            <td style="padding:10px 16px;color:#6c757d">Status</td>
            <td style="padding:10px 16px;color:#27ae60;font-weight:600">&#10003; Completed</td>
          </tr>
        </table>

        <p style="margin:24px 0 0;color:#6c757d;font-size:0.8rem;text-align:center">
          This is an automated receipt from {{ site_name | default('crypto-pay') | e }}.
          No tracking. No cookies.
        </p>
      </td>
    </tr>
  </table>
</body>
</html>
