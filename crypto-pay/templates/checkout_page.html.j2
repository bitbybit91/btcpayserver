{# checkout_page.html.j2 — Full checkout page template
   Variables:
     site_name   : Merchant site name
     product     : Product name
     fiat_amount : Amount in fiat
     fiat        : Fiat currency code
     api_base    : URL prefix for the crypto-pay API
     css_url     : URL to payment.css
     js_url      : URL to crypto-pay.js
#}
{% set api_base   = api_base   | default('/api') %}
{% set fiat       = fiat       | default('USD') %}
{% set css_url    = css_url    | default('/crypto-pay/css/payment.css') %}
{% set js_url     = js_url     | default('/crypto-pay/js/crypto-pay.js') %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Checkout — {{ site_name | default('Crypto Payment') | e }}</title>
  <link rel="stylesheet" href="{{ css_url | e }}">
  <style>
    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background: var(--cp-bg-secondary, #f8f9fa);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      padding: 24px 16px;
      box-sizing: border-box;
    }
    .cp-checkout-header {
      text-align: center;
      margin-bottom: 24px;
      color: var(--cp-text, #212529);
    }
    .cp-checkout-header h1 { margin: 0 0 8px; font-size: 1.4rem; }
    .cp-checkout-header p  { margin: 0; color: var(--cp-text-muted, #6c757d); }
  </style>
</head>
<body>
  <div class="cp-checkout-header">
    <h1>{{ site_name | default('Secure Checkout') | e }}</h1>
    <p>{{ product | default('') | e }}</p>
  </div>

  <div class="crypto-pay-widget" style="max-width:480px;width:100%">
    <div class="crypto-pay-header">
      <h2>&#8383; Select payment method</h2>
    </div>
    <div class="crypto-pay-body" id="cp-checkout-body">
      <div class="crypto-pay-coin-selector" id="cp-coin-selector"></div>

      <div class="crypto-pay-amount-box" id="cp-amount-box" style="display:none">
        <div class="crypto-pay-amount-fiat" id="cp-fiat-label"></div>
        <div class="crypto-pay-amount-crypto">
          <span id="cp-crypto-amount">—</span>
          <span class="crypto-pay-amount-ticker" id="cp-crypto-ticker"></span>
        </div>
      </div>

      <div class="crypto-pay-qr-section" id="cp-qr-section" style="display:none">
        <img id="cp-qr-img" src="" alt="QR code" width="200" height="200">
      </div>

      <div class="crypto-pay-address-row" id="cp-address-row" style="display:none">
        <span class="crypto-pay-address-text" id="cp-address"></span>
        <button class="crypto-pay-copy-btn" id="cp-copy-btn" aria-label="Copy">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2"/>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
          </svg>
        </button>
      </div>
      <div class="crypto-pay-copy-toast" id="cp-copy-toast" aria-live="polite"></div>
      <div class="crypto-pay-timer" id="cp-timer" aria-live="polite"></div>
      <div class="crypto-pay-status crypto-pay-status-pending" id="cp-status" style="display:none"></div>

      <form id="cp-tx-form" style="display:none" class="crypto-pay-tx-section">
        <label for="cp-tx-input">Transaction hash (optional)</label>
        <input id="cp-tx-input" class="crypto-pay-tx-input" type="text"
               placeholder="Paste your TX hash" autocomplete="off">
        <button type="submit" class="crypto-pay-btn" style="margin-top:10px">Submit TX hash</button>
      </form>

      <button class="crypto-pay-btn" id="cp-pay-btn" style="display:none">Proceed to Pay</button>
    </div>
    <div class="crypto-pay-footer">
      Powered by crypto-pay &bull; Self-hosted &bull; No tracking
    </div>
  </div>

  <script src="{{ js_url | e }}"></script>
  <script>
  (function () {
    'use strict';
    var API_BASE   = '{{ api_base | e }}';
    var FIAT_AMT   = parseFloat('{{ fiat_amount | default(0) | e }}');
    var FIAT_CUR   = '{{ fiat | upper | e }}';
    var PRODUCT    = '{{ product | default("") | e }}';

    CryptoPay.init({ apiBase: API_BASE });

    var selectedCoin = null;
    var currentOrder = null;

    /* Load coins */
    fetch(API_BASE + '/supported-coins', { credentials: 'omit' })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        var sel = document.getElementById('cp-coin-selector');
        (data.coins || []).forEach(function (coin) {
          if (!coin.ticker) return;
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'crypto-pay-coin-btn';
          btn.setAttribute('data-ticker', coin.ticker);
          btn.innerHTML = '<span style="font-size:1.4rem;">&#8383;</span><span>' + esc(coin.ticker) + '</span>';
          btn.addEventListener('click', function () {
            selectedCoin = coin.ticker;
            document.querySelectorAll('.crypto-pay-coin-btn').forEach(function (b) {
              b.classList.toggle('crypto-pay-selected', b === btn);
            });
            if (FIAT_AMT > 0) {
              CryptoPay.getPrice(coin.ticker, FIAT_CUR, FIAT_AMT).then(function (d) {
                document.getElementById('cp-amount-box').style.display = '';
                document.getElementById('cp-fiat-label').textContent = FIAT_AMT.toFixed(2) + ' ' + FIAT_CUR;
                document.getElementById('cp-crypto-amount').textContent = d.crypto_amount || '—';
                document.getElementById('cp-crypto-ticker').textContent = coin.ticker;
              });
            }
            document.getElementById('cp-pay-btn').style.display = '';
          });
          sel.appendChild(btn);
        });
      });

    document.getElementById('cp-pay-btn').addEventListener('click', function () {
      if (!selectedCoin) return;
      var btn = document.getElementById('cp-pay-btn');
      btn.disabled = true;
      btn.textContent = 'Creating order…';
      CryptoPay.createOrder({
        fiat_amount:     FIAT_AMT,
        fiat_currency:   FIAT_CUR.toLowerCase(),
        crypto_currency: selectedCoin,
        product_name:    PRODUCT,
        page_url:        window.location.href,
      }).then(function (order) {
        if (!order || order.error) {
          alert('Error: ' + (order && order.error ? order.error : 'network error'));
          btn.disabled = false;
          btn.textContent = 'Proceed to Pay';
          return;
        }
        currentOrder = order;
        btn.style.display = 'none';
        document.getElementById('cp-coin-selector').style.display = 'none';
        document.getElementById('cp-amount-box').style.display = '';
        document.getElementById('cp-fiat-label').textContent = order.fiat_amount.toFixed(2) + ' ' + FIAT_CUR;
        document.getElementById('cp-crypto-amount').textContent = order.crypto_amount;
        document.getElementById('cp-crypto-ticker').textContent = order.crypto_currency;
        document.getElementById('cp-qr-img').src = CryptoPay.qrUrl(order.order_id);
        document.getElementById('cp-qr-section').style.display = '';
        document.getElementById('cp-address').textContent = order.wallet_address;
        document.getElementById('cp-address-row').style.display = '';
        document.getElementById('cp-status').style.display = '';
        document.getElementById('cp-status').className = 'crypto-pay-status crypto-pay-status-pending';
        document.getElementById('cp-status').textContent = 'Waiting for payment…';
        document.getElementById('cp-tx-form').style.display = '';
        if (order.expires_at) CountdownTimer.start('cp-timer', order.expires_at);
        PaymentStatus.poll(order.order_id, 5000, function (status) {
          var el = document.getElementById('cp-status');
          var m = {
            completed: ['crypto-pay-status-completed', '&#10003; Payment confirmed!'],
            expired:   ['crypto-pay-status-expired',   'Payment window expired'],
            cancelled: ['crypto-pay-status-cancelled',  'Order cancelled'],
          };
          var info = m[status] || ['crypto-pay-status-pending', 'Waiting…'];
          el.className = 'crypto-pay-status ' + info[0];
          el.innerHTML = info[1];
          if (status === 'completed' || status === 'expired') {
            PaymentStatus.stop(order.order_id);
            document.getElementById('cp-tx-form').style.display = 'none';
          }
        });
      });
    });

    document.getElementById('cp-copy-btn').addEventListener('click', function () {
      var addr = document.getElementById('cp-address').textContent;
      if (navigator.clipboard) navigator.clipboard.writeText(addr).then(function () {
        var t = document.getElementById('cp-copy-toast');
        t.textContent = 'Copied!';
        setTimeout(function () { t.textContent = ''; }, 2000);
      });
    });

    document.getElementById('cp-tx-form').addEventListener('submit', function (e) {
      e.preventDefault();
      if (!currentOrder) return;
      var tx = document.getElementById('cp-tx-input').value.trim();
      if (!tx) return;
      CryptoPay.submitTxHash(currentOrder.order_id, tx).then(function (r) {
        if (!r.error) {
          document.getElementById('cp-status').textContent = 'Awaiting confirmation…';
        }
      });
    });

    function esc(s) {
      return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }
  }());
  </script>
</body>
</html>
