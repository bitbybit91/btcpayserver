# crypto-pay secrets — chmod 600 this file
# Copy to .env and fill in real values.  Never commit .env to version control.

# Flask session secret (generate with: python3 -c "import secrets; print(secrets.token_hex(32))")
CRYPTO_PAY_SECRET_KEY=changeme_generate_a_strong_random_value

# Admin API key for protected endpoints
CRYPTO_PAY_ADMIN_API_KEY=changeme_admin_api_key

# Database path (optional override)
# CRYPTO_PAY_DB_PATH=/var/lib/crypto-pay/crypto_pay.db

# CoinGecko Pro API key (optional — leave blank for free tier)
# COINGECKO_API_KEY=

# Webhook HMAC secret
# CRYPTO_PAY_WEBHOOK_SECRET=changeme_webhook_secret
